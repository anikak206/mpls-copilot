# Copy to backend/.env and replace every value. Never commit the real file.
MYSQL_HOST="127.0.0.1"
MYSQL_PORT="3306"
MYSQL_USER="mpls_app"
MYSQL_PASSWORD="change-me-strong-db-password"
MYSQL_DATABASE="mpls_copilot"
# Set to 1 for managed MySQL that requires TLS (Aiven, PlanetScale, ...). Leave unset for local Docker.
MYSQL_SSL="0"
MYSQL_ROOT_PASSWORD="change-me-root-password"
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET="change-me-64-hex-chars"
JWT_EXPIRE_MINUTES="60"
# Comma-separated list of allowed frontend origins
CORS_ORIGINS="http://localhost:3000"
# Development-only demo accounts (seeded on startup; leave blank to skip)
ADMIN_EMAIL="admin@mpls.local"
ADMIN_PASSWORD="change-me-admin"
ENGINEER_EMAIL="engineer@mpls.local"
ENGINEER_PASSWORD="change-me-engineer"
AUDITOR_EMAIL="auditor@mpls.local"
AUDITOR_PASSWORD="change-me-auditor"

# frontend/.env
# REACT_APP_BACKEND_URL="http://localhost:8001"
